# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# A variable that is commented out or absent takes the default named next to it. An empty value
# (NAME=) is read as the empty string, not as the default.
DATA_DIR=./data
OUTPUT_DIR=./outputs

# Nebius Token Factory (OpenAI-compatible) — powers the Nemotron case agent
NEBIUS_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Run `python -m muffle.report.nemotron --list-models` and paste a Nemotron id here
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# Model for the case-note writer (default nvidia/Nemotron-3-Ultra-550b-a55b)
# NEMOTRON_WRITER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# The hard cap on Token Factory spend is $25.50 (src/muffle/report/budget.py); this only lowers it
# TOKEN_FACTORY_BUDGET_USD=3
# Token Factory spend ledger file (default ~/.muffle/token_factory_spend.json)
# MUFFLE_SPEND_LEDGER=~/.muffle/token_factory_spend.json

# Optional: literature search in the case note (Best Use of Tavily bonus)
TAVILY_API_KEY=

# Demo (app/streamlit_app.py): live case notes allowed per browser session (default 5)
# DEMO_LIVE_NOTES_PER_SESSION=5
# Demo: path or URL of the demo bundle (default: the GitHub release asset)
# MUFFLE_BUNDLE=outputs/demo_bundle.pt

# Nebius Object Storage (S3-compatible); unused by the current code
# NEBIUS_BUCKET=
# AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
