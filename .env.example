# Copy to .env and fill in. .env is git-ignored — never commit real keys.
DATA_DIR=./data
OUTPUT_DIR=./outputs

# Nebius Token Factory (OpenAI-compatible) — powers the Nemotron report
NEBIUS_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Run `python -m muffle.report.nemotron --list-models` and paste a Nemotron id here
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
# Hard cap on Token Factory spend is $25.50 (src/muffle/report/budget.py); this can only lower it
TOKEN_FACTORY_BUDGET_USD=
# Model for the case-note writer (default nvidia/Nemotron-3-Ultra-550b-a55b)
NEMOTRON_WRITER_MODEL=

# Optional: literature search in the report (Best Use of Tavily bonus)
TAVILY_API_KEY=

# Demo (app/streamlit_app.py): live case notes allowed per session (default 5)
DEMO_LIVE_NOTES_PER_SESSION=
# Demo: path or URL of the data bundle (default: the GitHub release asset)
MUFFLE_BUNDLE=
# Token Factory spend ledger file (default ~/.muffle/token_factory_spend.json)
MUFFLE_SPEND_LEDGER=

# Nebius Object Storage (S3-compatible) for data used by GPU jobs
NEBIUS_BUCKET=
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
