# Copy to .env and fill in. .env is git-ignored — never commit real keys.
DATA_DIR=./data
OUTPUT_DIR=./outputs

# Nebius Token Factory (OpenAI-compatible) — powers the Nemotron report
NEBIUS_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Run `python -m muffle.report.nemotron --list-models` and paste a Nemotron id here
NEMOTRON_MODEL=

# Optional: literature search in the report (Best Use of Tavily bonus)
TAVILY_API_KEY=

# Nebius Object Storage (S3-compatible) for data used by GPU jobs
NEBIUS_BUCKET=
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
